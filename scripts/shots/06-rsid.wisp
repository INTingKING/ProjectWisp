# rsID with the pack installed: result row, jump (card pinned), not-in-pack message, rare-alleles line
key ctrl+k
type rs4680
wait 100
shotnow 15-rsid-result
key enter
shot 16-rsid-jump-card
key ctrl+k
type rs334
wait 100
shotnow 17-rsid-not-in-pack
key enter
key escape
key ctrl+k
type rs1056
key enter
shot 18-rsid-rare-alleles-line
