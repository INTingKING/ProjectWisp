# Legend panel (280 px, right of the region view): opened via --legend in a region with every track loaded
# (COMT 50 kb: genes, cCREs, repeats, variants, SVs, methylation), taller window so all rows fit; then via the L key
args --region chr22:20,320,000-20,370,000 --pin chr22:20,341,376 --legend --size 1600x1440
shot 31-legend-open-all-tracks
